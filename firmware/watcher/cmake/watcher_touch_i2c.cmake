# Watcher 的 SPD2010 已分离寄存器写/读；IDF 6 纯读必须传入无命令标志。
idf_component_get_property(watcher_touch_lib espressif__esp_lcd_touch_spd2010 COMPONENT_LIB)
idf_component_get_property(watcher_touch_dir espressif__esp_lcd_touch_spd2010 COMPONENT_DIR)
idf_build_get_property(watcher_touch_python PYTHON)
set(watcher_touch_generator "${CMAKE_SOURCE_DIR}/scripts/prepare_touch_i2c.py")
set(watcher_touch_input "${watcher_touch_dir}/esp_lcd_touch_spd2010.c")
set(watcher_touch_output "${CMAKE_BINARY_DIR}/watcher_touch/esp_lcd_touch_spd2010.c")
execute_process(COMMAND "${watcher_touch_python}" "${watcher_touch_generator}"
    --input "${watcher_touch_input}" --output "${watcher_touch_output}"
    RESULT_VARIABLE watcher_touch_status)
if(NOT watcher_touch_status EQUAL 0)
    message(FATAL_ERROR "Watcher SPD2010 IDF 6 纯读适配失败")
endif()
get_target_property(watcher_touch_sources ${watcher_touch_lib} SOURCES)
set(watcher_touch_new_sources "")
set(watcher_touch_count 0)
foreach(watcher_touch_source IN LISTS watcher_touch_sources)
    get_filename_component(watcher_touch_name "${watcher_touch_source}" NAME)
    if(watcher_touch_name STREQUAL "esp_lcd_touch_spd2010.c")
        list(APPEND watcher_touch_new_sources "${watcher_touch_output}")
        math(EXPR watcher_touch_count "${watcher_touch_count} + 1")
    else()
        list(APPEND watcher_touch_new_sources "${watcher_touch_source}")
    endif()
endforeach()
if(NOT watcher_touch_count EQUAL 1)
    message(FATAL_ERROR "Watcher SPD2010 编译源不唯一，请审查依赖升级")
endif()
set_property(TARGET ${watcher_touch_lib} PROPERTY SOURCES "${watcher_touch_new_sources}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${watcher_touch_input}" "${watcher_touch_generator}")
