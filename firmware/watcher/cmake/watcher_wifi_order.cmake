# 只对 Watcher 替换编译输入；上游受管理依赖原文件保持不变。
idf_component_get_property(watcher_wifi_lib 78__esp-wifi-connect COMPONENT_LIB)
idf_component_get_property(watcher_wifi_dir 78__esp-wifi-connect COMPONENT_DIR)
set(watcher_wifi_source "${watcher_wifi_dir}/wifi_station.cc")
set(watcher_wifi_generated "${CMAKE_BINARY_DIR}/watcher_wifi/wifi_station.cc")
set(watcher_wifi_generator "${CMAKE_SOURCE_DIR}/scripts/prepare_wifi_scan_order.py")
idf_build_get_property(watcher_wifi_python PYTHON)
execute_process(
    COMMAND "${watcher_wifi_python}" "${watcher_wifi_generator}" --input "${watcher_wifi_source}" --output "${watcher_wifi_generated}"
    RESULT_VARIABLE watcher_wifi_result
)
if(NOT watcher_wifi_result EQUAL 0)
    message(FATAL_ERROR "Watcher Wi-Fi 最近网络适配失败，禁止继续构建")
endif()
get_target_property(watcher_wifi_sources ${watcher_wifi_lib} SOURCES)
set(watcher_wifi_replaced 0)
set(watcher_wifi_result_sources "")
foreach(watcher_wifi_entry IN LISTS watcher_wifi_sources)
    get_filename_component(watcher_wifi_name "${watcher_wifi_entry}" NAME)
    if(watcher_wifi_name STREQUAL "wifi_station.cc")
        list(APPEND watcher_wifi_result_sources "${watcher_wifi_generated}")
        math(EXPR watcher_wifi_replaced "${watcher_wifi_replaced} + 1")
    else()
        list(APPEND watcher_wifi_result_sources "${watcher_wifi_entry}")
    endif()
endforeach()
if(NOT watcher_wifi_replaced EQUAL 1)
    message(FATAL_ERROR "Watcher Wi-Fi 编译源不唯一，需审查依赖升级")
endif()
set_property(TARGET ${watcher_wifi_lib} PROPERTY SOURCES "${watcher_wifi_result_sources}")
target_include_directories(${watcher_wifi_lib} PRIVATE "${CMAKE_SOURCE_DIR}/main/unitedrhino")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${watcher_wifi_source}" "${watcher_wifi_generator}")
