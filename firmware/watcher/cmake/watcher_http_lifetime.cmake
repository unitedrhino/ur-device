# Watcher 只替换编译输入，保留受管理 HTTP/TCP 源；锚点漂移时停止构建。
idf_component_get_property(watcher_http_lib 78__esp-ml307 COMPONENT_LIB)
idf_component_get_property(watcher_http_dir 78__esp-ml307 COMPONENT_DIR)
idf_build_get_property(watcher_http_python PYTHON)
set(watcher_http_generator "${CMAKE_SOURCE_DIR}/scripts/prepare_http_lifetime.py")
get_target_property(watcher_http_sources ${watcher_http_lib} SOURCES)
foreach(watcher_http_kind IN ITEMS http tcp)
    if(watcher_http_kind STREQUAL "http")
        set(watcher_http_relative "src/http_client.cc")
    else()
        set(watcher_http_relative "src/esp/esp_tcp.cc")
    endif()
    set(watcher_http_input "${watcher_http_dir}/${watcher_http_relative}")
    get_filename_component(watcher_http_name "${watcher_http_input}" NAME)
    set(watcher_http_output "${CMAKE_BINARY_DIR}/watcher_http/${watcher_http_name}")
    execute_process(COMMAND "${watcher_http_python}" "${watcher_http_generator}"
        --kind "${watcher_http_kind}" --input "${watcher_http_input}" --output "${watcher_http_output}"
        RESULT_VARIABLE watcher_http_status)
    if(NOT watcher_http_status EQUAL 0)
        message(FATAL_ERROR "Watcher HTTP/TCP 生命周期适配失败")
    endif()
    set(watcher_http_new_sources "")
    set(watcher_http_count 0)
    foreach(watcher_http_source IN LISTS watcher_http_sources)
        get_filename_component(watcher_http_basename "${watcher_http_source}" NAME)
        if(watcher_http_basename STREQUAL watcher_http_name)
            list(APPEND watcher_http_new_sources "${watcher_http_output}")
            math(EXPR watcher_http_count "${watcher_http_count} + 1")
        else()
            list(APPEND watcher_http_new_sources "${watcher_http_source}")
        endif()
    endforeach()
    if(NOT watcher_http_count EQUAL 1)
        message(FATAL_ERROR "Watcher HTTP/TCP 编译源不唯一，请审查依赖升级")
    endif()
    set(watcher_http_sources "${watcher_http_new_sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${watcher_http_input}")
endforeach()
set_property(TARGET ${watcher_http_lib} PROPERTY SOURCES "${watcher_http_sources}")
target_include_directories(${watcher_http_lib} PRIVATE "${watcher_http_dir}/src/esp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${watcher_http_generator}")
